<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="IpmsgReceiveWindow" parent="GtkWindow">
    <property name="title">受信メッセージ</property>
    <property name="default-width">480</property>
    <property name="default-height">340</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>

        <child>
          <object class="GtkLabel" id="sender_label">
            <property name="xalign">0</property>
            <property name="selectable">True</property>
            <style>
              <class name="ipmsg-section-label"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkLabel" id="meta_label">
            <property name="xalign">0</property>
            <style>
              <class name="ipmsg-status-label"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="seal_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="visible">False</property>
            <style>
              <class name="ipmsg-seal-banner"/>
            </style>
            <child>
              <object class="GtkLabel">
                <property name="label">封書メッセージです。開封して本文を表示します。</property>
                <property name="xalign">0</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="open_seal_button">
                <property name="label">開封</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">True</property>
            <property name="has-frame">True</property>
            <child>
              <object class="GtkTextView" id="body_text_view">
                <property name="editable">False</property>
                <property name="cursor-visible">False</property>
                <property name="wrap-mode">word-char</property>
                <style>
                  <class name="ipmsg-message-view"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="attachments_box">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="visible">False</property>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="reply_button">
                <property name="label">返信</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_ack_button">
                <property name="label">確認（閉じる）</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>